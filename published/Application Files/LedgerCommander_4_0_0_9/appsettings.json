{
  "_comment1": "en-US, hu-HU",
  "AppSettings": {
	"Language": "hu-HU",
	"UseCalculatedViews": true
  },  
  "_comment2": "Trace (Serilog uses Verbose), Debug, Information, Warning, Error, Critical (Serilog uses Fatal); [{Timestamp:HH:mm:ss.fff} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore.DataProtection": "Fatal",
        "Microsoft.Hosting.Lifetime": "Fatal",
        "Microsoft.Extensions.Hosting.Internal.Host": "Fatal",
		"Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}